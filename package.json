{
  "name": "memarium",
  "version": "0.17.0",
  "description": "Cross-device sync + resume for AI coding sessions (Claude Code, Copilot Chat, and Codex). Companion to the memarium Claude Code plugin which provides digest + recall.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/june9593/memarium.git"
  },
  "homepage": "https://github.com/june9593/memarium",
  "bugs": "https://github.com/june9593/memarium/issues",
  "keywords": [
    "memory",
    "ai",
    "claude",
    "copilot",
    "codex",
    "sessions",
    "digest",
    "vibe-coding",
    "memarium"
  ],
  "bin": {
    "memarium": "./dist/bin/memarium.js",
    "mema": "./dist/bin/memarium.js"
  },
  "files": [
    "dist/",
    "assets/",
    "skills/",
    "commands/",
    "hooks/",
    ".claude-plugin/",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx bin/memarium.ts",
    "prepack": "npm run build && chmod +x dist/bin/memarium.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "simple-git": "^3.25.0",
    "chalk": "^5.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
